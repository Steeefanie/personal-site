---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleComments from '../components/ArticleComments.astro';
import ArticleToc from '../components/ArticleToc.astro';
import ProseLayout from '../components/ProseLayout.astro';
import LocalizedText from '../components/LocalizedText.astro';
import ListingBackLink from '../components/ListingBackLink.astro';
import { localeDateFormats, locales, text, ui, type Locale, type Localized } from '../lib/i18n';
import { localizedPath } from '../lib/routes';

interface Adjacent { slug: string; titles: Localized<string> }
interface Props {
  locale: Locale;
  entries: Localized<CollectionEntry<'projects'>>;
  previous?: Adjacent;
  next?: Adjacent;
}

const { locale, entries, previous, next } = Astro.props;
const entry = entries[locale];
const { Content, headings } = await render(entry);
const base = entry.data;
const titles = Object.fromEntries(locales.map((locale) => [locale, `${entries[locale].data.title}${locale === 'en' ? ' | ' : '｜'}Steeefanie`])) as Localized<string>;
const descriptions = Object.fromEntries(locales.map((locale) => [locale, entries[locale].data.description])) as Localized<string>;
const sourceDate = base.updatedDate ?? base.publishDate;
const formattedDate = new Intl.DateTimeFormat(localeDateFormats[locale], { dateStyle: 'long' }).format(sourceDate);
const date = locale === 'en' ? `Updated ${formattedDate}` : locale === 'zh-TW' ? `更新於 ${formattedDate}` : `更新于 ${formattedDate}`;
---

<BaseLayout activeNav="projects" titles={titles} descriptions={descriptions} pageType="article" locale={locale}>
  <ArticleToc headings={headings} locale={locale} />
  <article class="article-with-comments article-toc-page" data-article-toc-page>
    <header class="article-header">
      <div class="reading-shell">
        <ListingBackLink href={localizedPath(locale, '/projects/')} label={text('返回项目', '返回專案', 'Back to Projects')} />
        <div class="article-title-row">
          <h1>{entry.data.title}</h1>
          {base.repositoryUrl && (
            <a class="project-repository-link" href={base.repositoryUrl} target="_blank" rel="noreferrer" aria-labelledby="project-repository-label">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.28-1.29-5.28-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18A11 11 0 0 1 12 6.13c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.25c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
              </svg>
              <span id="project-repository-label" class="sr-only"><LocalizedText value={text('在 GitHub 查看项目', '在 GitHub 查看專案', 'View project on GitHub')} /></span>
            </a>
          )}
        </div>
        <p class="article-deck">{entry.data.attribution && <span class="content-attribution">{entry.data.attribution}</span>}{entry.data.description}</p>
        <div class="article-meta">
          <time datetime={sourceDate.toISOString()}>{date}</time>
          <span class="tag-list">{base.stack.map((item) => <span class="tag">#{item}</span>)}</span>
        </div>
        {base.demoUrl && (
          <div class="project-actions">
            <a class="project-demo-link" href={base.demoUrl.startsWith('/') ? localizedPath(locale, base.demoUrl) : base.demoUrl}><LocalizedText value={text('在线体验', '線上體驗', 'Try it online')} /></a>
          </div>
        )}
      </div>
    </header>
    <ProseLayout>
      <Content />
    </ProseLayout>
    {(previous || next) && (
      <nav class="reading-shell article-pager" aria-label={ui.common.adjacentProjects[locale]}>
        {previous && <div class="pager-slot pager-slot--previous"><a class="pager-link" href={localizedPath(locale, `/projects/${previous.slug}/`)}><span class="pager-label"><LocalizedText value={text('上一篇', '上一篇', 'Previous')} /></span><span class="pager-title">{previous.titles[locale]}</span></a></div>}
        {next && <div class="pager-slot pager-slot--next"><a class="pager-link" href={localizedPath(locale, `/projects/${next.slug}/`)}><span class="pager-label"><LocalizedText value={text('下一篇', '下一篇', 'Next')} /></span><span class="pager-title">{next.titles[locale]}</span></a></div>}
      </nav>
    )}
    <ArticleComments />
  </article>
</BaseLayout>
