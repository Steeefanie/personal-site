---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { text, type Locale } from '../lib/i18n';
import { localizedPath } from '../lib/routes';
import '../styles/fuse-bead-generator.css';

interface Props { locale: Locale }

const { locale } = Astro.props;
const homePath = localizedPath(locale, '/');

const pageTitle = text('拼豆图纸生成器', '拼豆圖紙生成器', 'Fuse-bead pattern generator');
const pageDescription = text(
  '上传一张图片，按指定尺寸和颜色模式生成带坐标、色号和用量统计的拼豆图纸。',
  '上傳一張圖片，依指定尺寸與色彩模式產生含座標、色號與用量統計的拼豆圖紙。',
  'Upload an image and create a fuse-bead pattern with coordinates, colour codes, and bead counts.',
);
---

<BaseLayout activeNav="home" titles={pageTitle} descriptions={pageDescription} locale={locale}>
  <div class="site-shell service-page">
    <a class="service-back" href={`${homePath}#services-heading`} data-service-back data-service-home-path={homePath}><span aria-hidden="true">←</span><LocalizedText value={text('返回主页', '返回首頁', 'Back to home')} /></a>

    <header class="service-header">
      <h1><LocalizedText value={pageTitle} /></h1>
    </header>

    <section class="generator-shell" aria-label={text('拼豆图纸生成工具', '拼豆圖紙產生工具', 'Fuse-bead pattern generator')[locale]}>
      <form class="generator-form" data-generator-form>
        <fieldset class="form-group upload-group">
          <legend><span>1</span><LocalizedText value={text('上传图片', '上傳圖片', 'Upload image')} /></legend>
          <label class="upload-zone" data-upload-zone>
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" data-file-input required />
            <span class="upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14.5v3A2.5 2.5 0 0 0 7.5 20h9a2.5 2.5 0 0 0 2.5-2.5v-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <span class="upload-copy">
              <strong><LocalizedText value={text('点击选择或将图片拖到这里', '點擊選擇或將圖片拖到這裡', 'Choose an image or drop it here')} /></strong>
              <span>JPEG、PNG、WebP 或 HEIF · <LocalizedText value={text('最大 20 MB', '最大 20 MB', 'Up to 20 MB')} /></span>
            </span>
          </label>
          <div class="file-summary" data-file-summary hidden>
            <span class="file-summary-name" data-file-name></span><span data-file-meta></span>
            <button type="button" data-file-remove><LocalizedText value={text('移除', '移除', 'Remove')} /></button>
          </div>
          <p class="upload-privacy"><LocalizedText value={text('图片仅用于本次生成，处理完成后即删除。', '圖片僅用於本次產生，處理完成後即刪除。', 'Your image is used only for this request and deleted after processing.')} /></p>
          <p class="upload-apple-note"><LocalizedText value={text('使用 Apple 设备上传带透明背景的 HEIF 图片时，请先存储到“文件”App，再从“文件”中选择，以免透明区域显示为黑色。', '使用 Apple 裝置上傳帶透明背景的 HEIF 圖片時，請先儲存到「檔案」App，再從「檔案」中選擇，以免透明區域顯示為黑色。', 'When uploading a HEIF image with a transparent background from an Apple device, save it to the Files app first and then select it from Files to prevent transparent areas from appearing black.')} /></p>
          <p class="upload-message" role="status" aria-live="polite" data-upload-message hidden></p>
        </fieldset>

        <fieldset class="form-group">
          <legend><span>2</span><LocalizedText value={text('设置图纸尺寸', '設定圖紙尺寸', 'Set pattern size')} /></legend>
          <div class="size-row">
            <div class="side-switch" role="radiogroup" aria-label={text('固定宽度或高度', '固定寬度或高度', 'Choose a fixed width or height')[locale]}>
              <label><input type="radio" name="fixed_side" value="width" /><span><LocalizedText value={text('按宽度', '依寬度', 'By width')} /></span></label>
              <label><input type="radio" name="fixed_side" value="height" checked /><span><LocalizedText value={text('按高度', '依高度', 'By height')} /></span></label>
            </div>
            <label class="size-input"><input type="number" name="size" min="1" max="400" step="1" value="50" inputmode="numeric" required data-size-input /><span><LocalizedText value={text('格', '格', 'cells')} /></span></label>
          </div>
          <p class="form-help"><LocalizedText value={text('另一边按原图比例自动计算，图纸总格数不超过 20,000。', '另一邊依原圖比例自動計算，圖紙總格數不超過 20,000。', 'The other side is calculated automatically. Patterns are limited to 20,000 cells.')} /></p>
          <p class="size-estimate" data-size-estimate hidden></p>
        </fieldset>

        <fieldset class="form-group">
          <legend><span>3</span><LocalizedText value={text('选择颜色模式', '選擇色彩模式', 'Choose colour mode')} /></legend>
          <div class="mode-grid">
            <label class="mode-option"><input type="radio" name="mode" value="cm" /><span><strong><LocalizedText value={text('多色', '多色', 'More colours')} /></strong><small>CM</small></span></label>
            <label class="mode-option"><input type="radio" name="mode" value="cms" checked /><span><strong><LocalizedText value={text('适中', '適中', 'Balanced')} /></strong><small>CMS</small></span></label>
            <label class="mode-option"><input type="radio" name="mode" value="cs" /><span><strong><LocalizedText value={text('少色', '少色', 'Fewer colours')} /></strong><small>CS</small></span></label>
            <label class="mode-option"><input type="radio" name="mode" value="bw" /><span><strong><LocalizedText value={text('黑白', '黑白', 'Monochrome')} /></strong><small>BW</small></span></label>
          </div>
        </fieldset>

        <div class="form-submit-row">
          <button class="generate-button" type="submit" disabled data-generate-button><span data-button-label><LocalizedText value={text('生成图纸', '產生圖紙', 'Generate pattern')} /></span><span aria-hidden="true">→</span></button>
        </div>
        <p class="form-message" role="status" aria-live="polite" data-form-message hidden></p>
      </form>

      <section class="preview-panel" aria-labelledby="preview-heading">
        <div class="preview-heading-row">
          <div><p><LocalizedText value={text('预览', '預覽', 'Preview')} /></p><h2 id="preview-heading" data-preview-title><LocalizedText value={text('等待上传图片', '等待上傳圖片', 'Waiting for an image')} /></h2></div>
          <span class="preview-mode" data-preview-mode>CMS</span>
        </div>
        <div class="preview-stage">
          <div class="preview-empty" data-preview-empty><p><LocalizedText value={text('上传后可在这里检查原图和生成结果。', '上傳後可在這裡檢查原圖與產生結果。', 'Your source image and generated result will appear here.')} /></p></div>
          <img data-preview-image alt="" hidden />
          <div class="preview-loading" data-preview-loading hidden><span aria-hidden="true"></span><p><LocalizedText value={text('正在排队或生成图纸……', '正在排隊或產生圖紙……', 'Queueing or generating pattern…')} /></p></div>
        </div>
        <dl class="result-meta" data-result-meta hidden>
          <div><dt><LocalizedText value={text('图纸尺寸', '圖紙尺寸', 'Pattern size')} /></dt><dd data-result-size>—</dd></div>
          <div><dt><LocalizedText value={text('颜色模式', '色彩模式', 'Colour mode')} /></dt><dd data-result-mode>—</dd></div>
          <div><dt><LocalizedText value={text('色号总数', '色號總數', 'Colour count')} /></dt><dd data-result-count>—</dd></div>
        </dl>
        <a class="download-button" href="#" download hidden data-download-button><LocalizedText value={text('下载 PNG 图纸', '下載 PNG 圖紙', 'Download PNG pattern')} /><span aria-hidden="true">↓</span></a>
      </section>
    </section>

    <aside class="service-note">
      <strong><LocalizedText value={text('生成说明', '產生說明', 'About the generator')} /></strong>
      <p><LocalizedText value={text('色卡与实际拼豆品牌、批次可能存在色差。', '色卡與實際拼豆品牌、批次可能存在色差。', 'Palette colours may differ slightly from physical beads across brands and production batches.')} /></p>
      <a href={localizedPath(locale, '/projects/fuse-bead-pattern-generator/')}><LocalizedText value={text('查看算法与测试结果', '查看演算法與測試結果', 'View algorithm and test results')} /> ↗</a>
    </aside>
  </div>
</BaseLayout>

<script>
  import '../scripts/fuse-bead-generator';
</script>
