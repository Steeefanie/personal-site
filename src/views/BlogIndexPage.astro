---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import ListingPagination from '../components/ListingPagination.astro';
import { localizedData, pairEntries } from '../lib/content';
import { text, type Locale } from '../lib/i18n';

interface Props { locale: Locale }

const { locale } = Astro.props;

const entries = await getCollection('blog', ({ data }) => !data.draft);
const posts = pairEntries(entries);
---

<BaseLayout activeNav="blog" titles={text('随笔｜Steeefanie', '隨筆｜Steeefanie', 'Blog | Steeefanie')} descriptions={text('各种各样的技术笔记、踩坑经历、碎碎念。', '各式各樣的技術筆記、踩雷經歷與生活碎念。', 'Technical notes, lessons learned, and assorted thoughts.')} locale={locale}>
  <div class="site-shell">
    <section class="listing-section" aria-label={text('随笔', '隨筆', 'Blog')[locale]}>
      <ul class="content-list">
        {posts.map((post) => <PostListItem slug={post.slug} locales={localizedData(post)} locale={locale} />)}
      </ul>
      <ListingPagination pageSize={20} />
    </section>
  </div>
</BaseLayout>
