---
import { render, type CollectionEntry } from 'astro:content';
import '../styles/recipes.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { recipeCategorySlug } from '../lib/recipe-categories';
import ArticleComments from '../components/ArticleComments.astro';
import ArticlePagerLink from '../components/ArticlePagerLink.astro';
import ProseLayout from '../components/ProseLayout.astro';
import { locales, ui, type Locale, type Localized } from '../lib/i18n';
import { localizedPath } from '../lib/routes';
import imageLeftInsets from '../lib/recipe-image-left-insets.json';

interface Adjacent { slug: string; titles: Localized<string> }
interface Props {
  locale: Locale;
  entries: Localized<CollectionEntry<'recipes'>>;
  previous?: Adjacent;
  next?: Adjacent;
  categoryAdjacent?: { previous?: Adjacent; next?: Adjacent };
}

const { locale, entries, previous, next, categoryAdjacent } = Astro.props;
const entry = entries[locale];
const { Content } = await render(entry);
const base = entry.data;
const imageBounds = base.cover ? (imageLeftInsets as Record<string, { left: number; right: number }>)[base.cover] : undefined;
const imageLeftInset = imageBounds?.left ?? 0;
const imageVisibleWidth = (imageBounds?.right ?? 1) - imageLeftInset;
const titles = Object.fromEntries(locales.map((locale) => [locale, `${entries[locale].data.title}${locale === 'en' ? ' | ' : '｜'}Steeefanie`])) as Localized<string>;
const descriptions = Object.fromEntries(locales.map((locale) => [locale, entries[locale].data.description])) as Localized<string>;
---

<BaseLayout activeNav="recipes" titles={titles} descriptions={descriptions} pageType="article" locale={locale}>
  <article class:list={['article-with-comments', { 'cocktail-detail': base.category === 'cocktail', 'flour-detail': base.category === 'flour' }]}>
    <header class="article-header">
      <div class="reading-shell">
        <div class="recipe-detail-heading" style={`--recipe-icon-left-inset: ${imageLeftInset}; --recipe-icon-visible-width: ${imageVisibleWidth}`}>
          {base.cover && <div class="recipe-detail-art" aria-hidden="true"><img class="recipe-detail-icon" src={base.cover} alt="" width="256" height="256" decoding="async" /></div>}
          <div class="recipe-detail-copy">
            <h1>{entry.data.title}</h1>
            <p class="article-deck">{entry.data.description}</p>
            <div class="article-meta">
              <span class="status">{ui.category[base.category][locale]}</span>
              <span>{entry.data.prepTime}</span>
              <span>{entry.data.servings}</span>
              <span class="tag-list">{entry.data.tags.map((tag) => <span class="tag">#{tag.label}</span>)}</span>
            </div>
          </div>
        </div>
      </div>
    </header>
    <ProseLayout>
      <Content />
    </ProseLayout>
    {(previous || next) && (
      <nav class="reading-shell article-pager" data-recipe-pager="all" aria-label={ui.common.adjacentRecipes[locale]}>
        {previous && <div class="pager-slot pager-slot--previous"><ArticlePagerLink href={localizedPath(locale, `/recipes/${previous.slug}/`)} title={previous.titles[locale]} direction="previous" locale={locale} /></div>}
        {next && <div class="pager-slot pager-slot--next"><ArticlePagerLink href={localizedPath(locale, `/recipes/${next.slug}/`)} title={next.titles[locale]} direction="next" locale={locale} /></div>}
      </nav>
    )}
    {(categoryAdjacent?.previous || categoryAdjacent?.next) && (
      <nav class="reading-shell article-pager" data-recipe-pager={base.category} aria-label={ui.common.adjacentRecipes[locale]} hidden>
        {categoryAdjacent.previous && <div class="pager-slot pager-slot--previous"><ArticlePagerLink href={`${localizedPath(locale, `/recipes/${categoryAdjacent.previous.slug}/`)}?category=${recipeCategorySlug(base.category)}`} title={categoryAdjacent.previous.titles[locale]} direction="previous" locale={locale} /></div>}
        {categoryAdjacent.next && <div class="pager-slot pager-slot--next"><ArticlePagerLink href={`${localizedPath(locale, `/recipes/${categoryAdjacent.next.slug}/`)}?category=${recipeCategorySlug(base.category)}`} title={categoryAdjacent.next.titles[locale]} direction="next" locale={locale} /></div>}
      </nav>
    )}
    <script is:inline data-astro-rerun data-category={base.category} data-category-slug={recipeCategorySlug(base.category)}>
      (() => {
        const script = document.currentScript;
        const category = new URLSearchParams(location.search).get('category');
        const scope = category === script?.dataset.category || category === script?.dataset.categorySlug ? script.dataset.category : 'all';
        if (category === script?.dataset.category) {
          const url = new URL(location.href);
          url.searchParams.set('category', script.dataset.categorySlug);
          history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
        }
        script?.closest('article')?.querySelectorAll('[data-recipe-pager]').forEach((pager) => {
          pager.hidden = pager.dataset.recipePager !== scope;
        });
      })();
    </script>
    <ArticleComments />
  </article>
</BaseLayout>

<script>

import { onPageLoad } from '../scripts/page-lifecycle';
onPageLoad((scope) => {
  const addEventListener = scope.onWindow;
document.querySelectorAll<HTMLElement>('.recipe-detail-heading').forEach((heading) => {
    const copy = heading.querySelector<HTMLElement>('.recipe-detail-copy');
    if (!copy || !heading.querySelector('.recipe-detail-art')) return;
    // Match the text block while retaining room for text on narrow screens.
    const syncIconSize = () => {
      const size = Math.min(copy.getBoundingClientRect().height, heading.clientWidth * 0.4);
      const value = `${size}px`;
      if (heading.style.getPropertyValue('--recipe-detail-icon-size') !== value) {
        heading.style.setProperty('--recipe-detail-icon-size', value);
      }
    };
    const observer = new ResizeObserver(() => requestAnimationFrame(syncIconSize));
    scope.cleanup(() => observer.disconnect());
    observer.observe(copy);
    observer.observe(heading);
    syncIconSize();
    addEventListener('pagehide', () => observer.disconnect(), { once: true });
    addEventListener('pageshow', () => { observer.observe(copy); observer.observe(heading); syncIconSize(); });
  });
});
</script>
