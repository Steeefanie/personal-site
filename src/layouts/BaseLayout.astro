---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { locales, text, ui, type Locale, type Localized } from '../lib/i18n';
import { localizedAbsoluteUrls, logicalPathname, openGraphLocales } from '../lib/routes';
import '../styles/global.css';

interface Props {
  titles?: Localized<string>;
  descriptions?: Localized<string>;
  activeNav?: 'home' | 'blog' | 'projects' | 'recipes';
  pageType?: 'website' | 'article';
  locale?: Locale;
}

const defaultTitles = text('Steeefanie｜个人网站', 'Steeefanie｜個人網站', 'Steeefanie | Personal Site');
const defaultDescriptions = ui.home.description;
const {
  titles = defaultTitles,
  descriptions = defaultDescriptions,
  activeNav = 'home',
  pageType = 'website',
  locale = 'zh-CN',
} = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const alternateUrls = localizedAbsoluteUrls(Astro.url.pathname, site);
const canonicalUrl = alternateUrls[locale];
const xDefaultUrl = logicalPathname(Astro.url.pathname) === '/'
  ? new URL('/', site).href
  : alternateUrls['zh-CN'];
const title = titles[locale];
const description = descriptions[locale];
const alternateLocales = locales.filter((candidate) => candidate !== locale);
---

<!doctype html>
<html lang={locale} data-language={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Steeefanie" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {alternateLocales.map((candidate) => <meta property="og:locale:alternate" content={openGraphLocales[candidate]} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {locales.map((candidate) => <link rel="alternate" hreflang={candidate} href={alternateUrls[candidate]} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link id="site-favicon" rel="icon" href="/brand/favicon-light-nobg.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#141414' : '#f5f5f5');
          document.querySelector('#site-favicon')?.setAttribute('href', theme === 'dark'
            ? '/brand/favicon-dark-nobg.svg'
            : '/brand/favicon-light-nobg.svg');

        } catch (_) {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('#site-favicon')?.setAttribute('href', '/brand/favicon-light-nobg.svg');
        }
      })();
    </script>
    <script is:inline>
      (() => {
        try {
          const raw = sessionStorage.getItem('language-route-scroll');
          const state = raw ? JSON.parse(raw) : null;
          const listingReturn = JSON.parse(sessionStorage.getItem('listing-return-position') ?? 'null');
          history.scrollRestoration = state?.target === `${location.pathname}${location.search}`
            || (listingReturn?.url === `${location.pathname}${location.search}${location.hash}`
              && Number.isFinite(listingReturn.scrollY) && listingReturn.scrollY >= 0)
            ? 'manual'
            : 'auto';
        } catch (_) { history.scrollRestoration = 'auto'; }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <LocalizedText value={text('跳到主要内容', '跳至主要內容', 'Skip to content')} />
    </a>
    <SiteHeader activeNav={activeNav} locale={locale} />
    <main id="main-content" class="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      try {
        const key = 'language-route-scroll';
        const raw = sessionStorage.getItem(key);
        if (raw) {
          const state = JSON.parse(raw) as {
            target?: string;
            scrollY?: number;
            progress?: number;
            headingIndex?: number;
            headingOffset?: number;
          };
          if (state.target === `${location.pathname}${location.search}`) {
            sessionStorage.removeItem(key);
            const restorePosition = () => requestAnimationFrame(() => {
              const headings = [...document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)')];
              const heading = Number.isInteger(state.headingIndex) && (state.headingIndex ?? -1) >= 0
                ? headings[state.headingIndex ?? -1]
                : undefined;
              if (heading) {
                const offset = Number.isFinite(state.headingOffset) ? state.headingOffset ?? 0 : 0;
                scrollTo({ top: Math.max(0, scrollY + heading.getBoundingClientRect().top - offset), behavior: 'instant' });
              } else {
                const maximumScroll = Math.max(0, document.documentElement.scrollHeight - innerHeight);
                const progress = Number.isFinite(state.progress) ? Math.min(Math.max(state.progress ?? 0, 0), 1) : 0;
                const rawY = Number.isFinite(state.scrollY) ? state.scrollY ?? 0 : 0;
                scrollTo({ top: maximumScroll > 0 ? maximumScroll * progress : rawY, behavior: 'instant' });
              }
            });
            if (document.readyState === 'complete') restorePosition();
            else addEventListener('load', restorePosition, { once: true });
          } else sessionStorage.removeItem(key);
        }
      } catch (_) { /* Storage or stored data may be unavailable. */ }
    </script>
  </body>
</html>
