---
import '../styles/global.css';

const site = Astro.site ?? new URL(Astro.url.origin);
const rootUrl = new URL('/', site).href;
const localeUrls = {
  'zh-cn': new URL('/zh-cn/', site).href,
  'zh-tw': new URL('/zh-tw/', site).href,
  en: new URL('/en/', site).href,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Choose the display language for Steeefanie's personal site." />
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="canonical" href={rootUrl} />
    <link rel="alternate" hreflang="zh-CN" href={localeUrls['zh-cn']} />
    <link rel="alternate" hreflang="zh-TW" href={localeUrls['zh-tw']} />
    <link rel="alternate" hreflang="en" href={localeUrls.en} />
    <link rel="alternate" hreflang="x-default" href={rootUrl} />
    <link id="site-favicon" rel="icon" href="/brand/favicon-light-nobg.svg" type="image/svg+xml" />
    <title>Steeefanie</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#141414' : '#f5f5f5');
          document.querySelector('#site-favicon')?.setAttribute('href', theme === 'dark'
            ? '/brand/favicon-dark-nobg.svg'
            : '/brand/favicon-light-nobg.svg');
        } catch (_) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const destinations = { 'zh-cn': '/zh-cn/', 'zh-tw': '/zh-tw/', en: '/en/' };
        const cookieName = 'steeefanie_locale';
        const savedPreference = document.cookie
          .split('; ')
          .find((part) => part.startsWith(`${cookieName}=`))
          ?.slice(cookieName.length + 1)
          .toLowerCase();

        const matchLanguage = (value) => {
          const tag = String(value ?? '').trim().replace('_', '-').toLowerCase();
          if (!tag) return null;
          if (tag === 'zh-tw' || tag === 'zh-hk' || tag === 'zh-mo' || tag.startsWith('zh-hant')) return 'zh-tw';
          if (tag === 'zh-cn' || tag === 'zh-sg' || tag.startsWith('zh-hans') || tag === 'zh') return 'zh-cn';
          if (tag === 'en' || tag.startsWith('en-')) return 'en';
          return null;
        };

        const savedLocale = savedPreference && savedPreference in destinations ? savedPreference : null;
        const browserLocale = (navigator.languages?.length ? navigator.languages : [navigator.language])
          .map(matchLanguage)
          .find(Boolean);
        const locale = savedLocale ?? browserLocale ?? 'zh-cn';
        location.replace(`${destinations[locale]}${location.search}${location.hash}`);
      })();
    </script>
  </head>
  <body>
    <main class="language-gateway" aria-labelledby="language-gateway-title">
      <h1 id="language-gateway-title">Steeefanie</h1>
      <p>请选择语言 · 請選擇語言 · Choose a language</p>
      <nav aria-label="Language">
        <a href="/zh-cn/" lang="zh-CN" hreflang="zh-CN">简体中文</a>
        <a href="/zh-tw/" lang="zh-TW" hreflang="zh-TW">繁體中文</a>
        <a href="/en/" lang="en" hreflang="en">English</a>
      </nav>
    </main>
  </body>
</html>

<style>
  .language-gateway {
    box-sizing: border-box;
    display: grid;
    min-height: 100svh;
    place-content: center;
    gap: var(--space-5);
    padding: 30px;
    text-align: center;
  }

  .language-gateway h1,
  .language-gateway p {
    margin: 0;
  }

  .language-gateway h1 {
    color: var(--brand-readable);
    font-size: var(--font-size-section-title);
  }

  .language-gateway p {
    color: var(--muted);
  }

  .language-gateway nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
  }

  .language-gateway a {
    color: var(--brand-interactive);
    text-underline-offset: .2em;
  }
</style>
