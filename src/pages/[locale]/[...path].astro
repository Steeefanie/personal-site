---
import { getCollection, type CollectionEntry } from 'astro:content';
import HomePage from '../../views/HomePage.astro';
import BlogIndexPage from '../../views/BlogIndexPage.astro';
import BlogDetailPage from '../../views/BlogDetailPage.astro';
import ProjectsIndexPage from '../../views/ProjectsIndexPage.astro';
import ProjectDetailPage from '../../views/ProjectDetailPage.astro';
import RecipesIndexPage from '../../views/RecipesIndexPage.astro';
import RecipeDetailPage from '../../views/RecipeDetailPage.astro';
import FuseBeadGeneratorPage from '../../views/FuseBeadGeneratorPage.astro';
import FourElementsPage from '../../views/FourElementsPage.astro';
import { pairEntries, type LocalizedGroup } from '../../lib/content';
import { locales, type Locale, type Localized } from '../../lib/i18n';
import { routeLocaleParams } from '../../lib/routes';

type SupportedEntry = CollectionEntry<'blog'> | CollectionEntry<'projects'> | CollectionEntry<'recipes'>;
interface Adjacent {
  slug: string;
  titles: Localized<string>;
}
type IndexRoute = {
  page: 'home' | 'blog-index' | 'projects-index' | 'recipes-index' | 'service' | 'four-elements';
  locale: Locale;
};
type DetailRoute<T extends SupportedEntry, TPage extends string> = {
  page: TPage;
  locale: Locale;
  entries: Localized<T>;
  previous?: Adjacent;
  next?: Adjacent;
  categoryAdjacent?: { previous?: Adjacent; next?: Adjacent };
};
type RouteProps = IndexRoute
  | DetailRoute<CollectionEntry<'blog'>, 'blog-detail'>
  | DetailRoute<CollectionEntry<'projects'>, 'projects-detail'>
  | DetailRoute<CollectionEntry<'recipes'>, 'recipes-detail'>;

export async function getStaticPaths() {
  const [blogEntries, projectEntries, recipeEntries] = await Promise.all([
    getCollection('blog', ({ data }) => !data.draft),
    getCollection('projects', ({ data }) => !data.draft),
    getCollection('recipes', ({ data }) => !data.draft),
  ]);
  const blogs = pairEntries(blogEntries);
  const projects = pairEntries(projectEntries);
  const recipes = pairEntries(recipeEntries);

  const adjacentFor = <T extends SupportedEntry>(group: LocalizedGroup<T> | undefined): Adjacent | undefined => group
    ? {
        slug: group.slug,
        titles: Object.fromEntries(locales.map((locale) => [locale, group.locales[locale].data.title])) as Localized<string>,
      }
    : undefined;

  const detailRoutes = <T extends SupportedEntry>(
    localeParam: string,
    locale: Locale,
    section: 'blog' | 'projects' | 'recipes',
    groups: LocalizedGroup<T>[],
  ) => groups.map((group, index) => {
    const category = section === 'recipes'
      ? recipes.find((candidate) => candidate.slug === group.slug)?.locales['zh-CN'].data.category
      : undefined;
    const categoryGroups = category
      ? recipes.filter((candidate) => candidate.locales['zh-CN'].data.category === category)
      : [];
    const categoryIndex = categoryGroups.findIndex((candidate) => candidate.slug === group.slug);
    return {
      params: { locale: localeParam, path: `${section}/${group.slug}` },
      props: {
        page: `${section}-detail`,
        locale,
        entries: group.locales,
        previous: adjacentFor(groups[index - 1]),
        next: adjacentFor(groups[index + 1]),
        categoryAdjacent: section === 'recipes' ? {
          previous: adjacentFor(categoryGroups[categoryIndex - 1]),
          next: adjacentFor(categoryGroups[categoryIndex + 1]),
        } : undefined,
      },
    };
  });

  return Object.entries(routeLocaleParams).flatMap(([localeParam, locale]) => [
    { params: { locale: localeParam, path: undefined }, props: { page: 'home', locale } },
    { params: { locale: localeParam, path: 'blog' }, props: { page: 'blog-index', locale } },
    { params: { locale: localeParam, path: 'projects' }, props: { page: 'projects-index', locale } },
    { params: { locale: localeParam, path: 'recipes' }, props: { page: 'recipes-index', locale } },
    { params: { locale: localeParam, path: 'services/fuse-bead-generator' }, props: { page: 'service', locale } },
    { params: { locale: localeParam, path: 'services/four-elements' }, props: { page: 'four-elements', locale } },
    ...detailRoutes(localeParam, locale, 'blog', blogs),
    ...detailRoutes(localeParam, locale, 'projects', projects),
    ...detailRoutes(localeParam, locale, 'recipes', recipes),
  ]);
}

const pageProps = Astro.props as RouteProps;
---

{pageProps.page === 'home' && <HomePage locale={pageProps.locale} />}
{pageProps.page === 'blog-index' && <BlogIndexPage locale={pageProps.locale} />}
{pageProps.page === 'blog-detail' && <BlogDetailPage locale={pageProps.locale} entries={pageProps.entries} previous={pageProps.previous} next={pageProps.next} />}
{pageProps.page === 'projects-index' && <ProjectsIndexPage locale={pageProps.locale} />}
{pageProps.page === 'projects-detail' && <ProjectDetailPage locale={pageProps.locale} entries={pageProps.entries} previous={pageProps.previous} next={pageProps.next} />}
{pageProps.page === 'recipes-index' && <RecipesIndexPage locale={pageProps.locale} />}
{pageProps.page === 'recipes-detail' && <RecipeDetailPage locale={pageProps.locale} entries={pageProps.entries} previous={pageProps.previous} next={pageProps.next} categoryAdjacent={pageProps.categoryAdjacent} />}
{pageProps.page === 'service' && <FuseBeadGeneratorPage locale={pageProps.locale} />}
{pageProps.page === 'four-elements' && <FourElementsPage locale={pageProps.locale} />}
