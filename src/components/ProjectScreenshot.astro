---
interface Props {
  locale: 'zh-cn' | 'zh-tw' | 'en';
  scene: 'desktop-login' | 'desktop-files' | 'desktop-upload' | 'desktop-monitor' | 'ios-login' | 'ios-files';
  alt: string;
  caption: string;
}

const { locale, scene, alt, caption } = Astro.props;
const portrait = scene.startsWith('ios-');
const width = portrait ? 960 : 1600;
const height = portrait ? 1961 : 1100;
const smallWidth = portrait ? 480 : 800;
const base = `/images/projects/private-drive/${locale}/${scene}`;
const sizes = portrait ? '(max-width: 800px) 44vw, 360px' : '(max-width: 800px) 90vw, 740px';
const placeholder = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}"/>`)}`;
---

<figure class:list={['project-figure', 'project-screenshot', { portrait }]}>
  <a href={`${base}-light.webp`} target="_blank" rel="noopener noreferrer"
    data-project-screenshot data-base={base} data-width={width} data-small-width={smallWidth}>
    <img src={placeholder} width={width} height={height} alt={alt} sizes={sizes}
      loading="lazy" decoding="async" data-themed-image />
    <noscript><img src={`${base}-light.webp`}
      srcset={`${base}-light-${smallWidth}.webp ${smallWidth}w, ${base}-light.webp ${width}w`}
      width={width} height={height} alt={alt} sizes={sizes} loading="lazy" decoding="async" /></noscript>
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<noscript><style>[data-themed-image] { display: none !important; }</style></noscript>

<script>
  const updateScreenshots = () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    document.querySelectorAll<HTMLAnchorElement>('[data-project-screenshot]').forEach((link) => {
      const { base, width, smallWidth } = link.dataset;
      const image = link.querySelector<HTMLImageElement>('[data-themed-image]');
      if (!image || !base || !width || !smallWidth) return;
      link.href = `${base}-${theme}.webp`;
      image.srcset = `${base}-${theme}-${smallWidth}.webp ${smallWidth}w, ${base}-${theme}.webp ${width}w`;
      image.src = link.href;
    });
  };
  updateScreenshots();
  window.addEventListener('site:theme-change', updateScreenshots);
</script>

<style>
  :global(.prose) .project-screenshot.portrait {
    max-width: 360px;
    margin-inline: auto;
  }
  :global(.prose) .project-screenshot a {
    overflow: visible;
    background: transparent;
    border-radius: 0;
  }
  :global(.prose) .project-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    background: transparent;
    border-radius: 0;
  }
</style>
