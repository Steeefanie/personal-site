---
import GiscusComments from './GiscusComments.astro';
import LocalizedText from './LocalizedText.astro';
import { ui } from '../lib/i18n';
import { localeFromPathname } from '../lib/routes';

const locale = localeFromPathname(Astro.url.pathname);
---

<dialog
  class="guestbook-dialog"
  data-guestbook-dialog
  tabindex="-1"
  autofocus
  aria-labelledby="guestbook-title"
  aria-describedby="guestbook-intro guestbook-privacy guestbook-login"
>
  <div class="guestbook-shell">
    <header class="guestbook-header">
      <button
        type="button"
        class="guestbook-close"
        data-guestbook-close
        aria-label={ui.guestbook.close[locale]}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6L18 18M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </header>
    <div class="guestbook-scroll">
      <div class="guestbook-layout">
        <aside class="guestbook-info">
          <h2 id="guestbook-title"><LocalizedText value={ui.guestbook.title} /></h2>
          <p id="guestbook-intro"><LocalizedText value={ui.guestbook.intro} /></p>
          <div class="guestbook-notes">
            <p id="guestbook-privacy"><LocalizedText value={ui.guestbook.privacy} /></p>
            <p id="guestbook-login"><LocalizedText value={ui.guestbook.login} /></p>
          </div>
        </aside>
        <main class="guestbook-comments">
          <GiscusComments mode="guestbook" />
        </main>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { lockPageScroll, unlockPageScroll } from '../lib/scroll-lock';

  const dialog = document.querySelector<HTMLDialogElement>('[data-guestbook-dialog]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-guestbook-open]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-guestbook-close]');
  let closeTimer = 0;

  const finishClose = () => {
    if (!dialog?.open) return;
    dialog.close();
    dialog.classList.remove('is-closing');
    document.documentElement.classList.remove('guestbook-open');
    unlockPageScroll('guestbook');
    if (openButton) {
      openButton.classList.add('is-focus-restored');
      openButton.addEventListener(
        'blur',
        () => openButton.classList.remove('is-focus-restored'),
        { once: true },
      );
      openButton.focus({ preventScroll: true });
    }
  };

  const requestClose = () => {
    if (!dialog?.open || dialog.classList.contains('is-closing')) return;
    dialog.classList.add('is-closing');
    window.dispatchEvent(new CustomEvent('site:guestbook-closing'));
    window.clearTimeout(closeTimer);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) finishClose();
    else closeTimer = window.setTimeout(finishClose, 220);
  };

  openButton?.addEventListener('click', () => {
    if (!dialog || dialog.open) return;
    window.dispatchEvent(new CustomEvent('site:close-panels'));
    lockPageScroll('guestbook');
    document.documentElement.classList.add('guestbook-open');
    try {
      dialog.showModal();
    } catch (error) {
      document.documentElement.classList.remove('guestbook-open');
      unlockPageScroll('guestbook');
      console.error(error);
      return;
    }
    window.dispatchEvent(new CustomEvent('site:guestbook-open'));
    requestAnimationFrame(() => dialog.focus({ preventScroll: true }));
  });

  closeButton?.addEventListener('click', requestClose);
  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    requestClose();
  });
</script>
