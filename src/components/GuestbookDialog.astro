---
import GiscusComments from './GiscusComments.astro';
import LocalizedText from './LocalizedText.astro';
import { ui } from '../lib/i18n';
import { localeFromPathname } from '../lib/routes';

const locale = localeFromPathname(Astro.url.pathname);
---

<div class="guestbook-backdrop" data-guestbook-backdrop hidden aria-hidden="true"></div>
<dialog
  class="guestbook-dialog"
  data-guestbook-dialog
  tabindex="-1"
  autofocus
  aria-labelledby="guestbook-title"
  aria-describedby="guestbook-intro guestbook-privacy guestbook-login"
>
  <div class="guestbook-material glass-surface glass-surface--panel" data-glass="dialog" aria-hidden="true"></div>
  <div class="guestbook-shell">
    <button
      type="button"
      class="guestbook-close"
      data-guestbook-close
      aria-label={ui.guestbook.close[locale]}
    >
      <span class="guestbook-close-surface glass-surface" data-glass="control" aria-hidden="true"></span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6L18 18M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    </button>
    <div class="guestbook-scroll">
      <div class="guestbook-layout">
        <aside class="guestbook-info">
          <h2 id="guestbook-title"><LocalizedText value={ui.guestbook.title} /></h2>
          <p id="guestbook-intro"><LocalizedText value={ui.guestbook.intro} /></p>
          <div class="guestbook-notes">
            <p id="guestbook-privacy"><LocalizedText value={ui.guestbook.privacy} /></p>
            <p id="guestbook-login"><LocalizedText value={ui.guestbook.login} /></p>
          </div>
        </aside>
        <main class="guestbook-comments">
          <GiscusComments mode="guestbook" />
        </main>
      </div>
    </div>
  </div>
</dialog>

<script>
import { lockPageScroll, unlockPageScroll } from '../lib/scroll-lock';
import { onPageLoad } from '../scripts/page-lifecycle';
onPageLoad((scope) => {
  const dialog = document.querySelector<HTMLDialogElement>('[data-guestbook-dialog]');
  const backdrop = document.querySelector<HTMLElement>('[data-guestbook-backdrop]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-guestbook-open]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-guestbook-close]');
  const scroll = dialog?.querySelector<HTMLElement>('.guestbook-scroll');
  const alignCloseButton = () => {
    if (!dialog || !scroll) return;
    dialog.style.setProperty('--guestbook-scrollbar-width', `${scroll.offsetWidth - scroll.clientWidth}px`);
  };
  const scrollbarObserver = new ResizeObserver(alignCloseButton);
  if (scroll) scrollbarObserver.observe(scroll);
  scope.cleanup(() => scrollbarObserver.disconnect());
  const backgroundState = new Map<HTMLElement, boolean>();
  let closeTimer = 0;

  const finishClose = (restoreFocus = true) => {
    if (!dialog?.open) return;
    window.clearTimeout(closeTimer);
    dialog.close();
    dialog.classList.remove('is-closing');
    if (backdrop) { backdrop.hidden = true; backdrop.classList.remove('is-closing'); }
    document.documentElement.classList.remove('guestbook-open');
    backgroundState.forEach((inert, element) => { element.inert = inert; });
    backgroundState.clear();
    unlockPageScroll('guestbook');
    if (restoreFocus && openButton) {
      openButton.classList.add('is-focus-restored');
      openButton.addEventListener(
        'blur',
        () => openButton.classList.remove('is-focus-restored'),
        { once: true },
      );
      openButton.focus({ preventScroll: true });
    }
  };

  const requestClose = () => {
    if (!dialog?.open || dialog.classList.contains('is-closing')) return;
    dialog.classList.add('is-closing');
    backdrop?.classList.add('is-closing');
    window.dispatchEvent(new CustomEvent('site:guestbook-closing'));
    window.clearTimeout(closeTimer);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) finishClose();
    else closeTimer = window.setTimeout(() => finishClose(), 180);
  };

  openButton?.addEventListener('click', () => {
    if (!dialog || dialog.open) return;
    window.dispatchEvent(new CustomEvent('site:close-panels', { detail: { immediately: true } }));
    lockPageScroll('guestbook');
    document.documentElement.classList.add('guestbook-open');
    try {
      // A modal dialog makes the header inert at browser level. Keep only the
      // page content inert so navigation, search and theme controls remain usable.
      dialog.show();
      alignCloseButton();
      document.querySelectorAll<HTMLElement>('#main-content, body > footer').forEach((element) => {
        backgroundState.set(element, element.inert);
        element.inert = true;
      });
      if (backdrop) backdrop.hidden = false;
    } catch (error) {
      document.documentElement.classList.remove('guestbook-open');
      unlockPageScroll('guestbook');
      console.error(error);
      return;
    }
    window.dispatchEvent(new CustomEvent('site:guestbook-open'));
    requestAnimationFrame(() => dialog.focus({ preventScroll: true }));
  });

  closeButton?.addEventListener('click', requestClose);
  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    requestClose();
  });

  scope.onWindow('keydown', (event) => {
    if (event.key !== 'Escape' || event.defaultPrevented || !dialog?.open) return;
    event.preventDefault();
    requestClose();
  });
  scope.onWindow('site:panel-opening', ((event: CustomEvent<{ panel: string }>) => {
    if (event.detail.panel === 'search') finishClose(false);
  }) as EventListener);

  scope.cleanup(() => finishClose(false));
});
</script>
