---
import ThemeSwitcher from './ThemeSwitcher.astro';
import SearchPanel from './SearchPanel.astro';
import LocalizedText from './LocalizedText.astro';
import { ui, type Locale } from '../lib/i18n';
import { localizedPath } from '../lib/routes';

interface Props {
  activeNav: 'home' | 'blog' | 'projects' | 'recipes';
  locale: Locale;
}

const { activeNav, locale } = Astro.props;
const navItems = [
  { key: 'home', href: '/', label: ui.nav.home },
  { key: 'blog', href: '/blog/', label: ui.nav.blog },
  { key: 'projects', href: '/projects/', label: ui.nav.projects },
  { key: 'recipes', href: '/recipes/', label: ui.nav.recipes },
] as const;
---

<div class="top-chrome" data-top-chrome transition:persist="site-chrome" transition:animate="none">
      <a class="site-name" href={localizedPath(locale, '/')} aria-label="Steeefanie">
        <span class="site-name-mark" aria-hidden="true">
          <img class="site-name-mark-image site-name-mark-image--light" src="/brand/favicon-light-nobg.svg" alt="" width="27" height="27" decoding="sync" draggable="false" />
          <img class="site-name-mark-image site-name-mark-image--dark" src="/brand/favicon-dark-nobg.svg" alt="" width="27" height="27" decoding="sync" draggable="false" />
        </span>
        <span class="site-name-text">teeefanie</span>
      </a>
  <header class="site-header">
    <div class="site-shell header-inner">
      <div class="header-actions">
        <nav class="primary-nav has-selection-slider" style={`--selection-index: ${navItems.findIndex((item) => item.key === activeNav)}`} aria-label={ui.common.primaryNavigation[locale]}>
          <div class="top-chrome-surface glass-surface" data-glass="navigation" aria-hidden="true"></div>
          {navItems.map((item) => (
            <a class="nav-link" href={localizedPath(locale, item.href)} aria-current={activeNav === item.key ? 'page' : undefined}>
              <LocalizedText value={item.label} />
            </a>
          ))}
          <span class="selection-slider" aria-hidden="true"></span>
        </nav>
        <div class="header-utilities">
        <div class="top-chrome-surface glass-surface" data-glass="navigation" aria-hidden="true"></div>
        <button
          class="utility-button search-switcher"
          type="button"
          data-panel-trigger="search"
          aria-controls="search-panel"
          aria-expanded="false"
          aria-label={ui.common.search[locale]}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.75" cy="10.75" r="6.75" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m15.7 15.7 4.05 4.05" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
        <ThemeSwitcher />
        </div>
        <button
          class="utility-button menu-switcher"
          type="button"
          data-panel-trigger="navigation"
          aria-controls="navigation-panel"
          aria-expanded="false"
          aria-label={ui.common.openMenu[locale]}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8.5h14M5 15.5h14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          <span class="top-chrome-surface glass-surface" data-glass="navigation" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>

  <button class="search-backdrop" type="button" data-search-backdrop data-panel-close tabindex="-1" aria-hidden="true" hidden></button>
  <SearchPanel defaultScope={activeNav === 'home' ? 'all' : activeNav} />

  <nav id="navigation-panel" class="header-panel navigation-panel glass-menu" data-panel="navigation" aria-label={ui.common.mobileNavigation[locale]} hidden>
    <div class="top-chrome-surface glass-surface" data-glass="menu" aria-hidden="true"></div>
    <div class="site-shell panel-inner mobile-nav-list menu-choice-group">
      {navItems.map((item) => (
        <a class="mobile-nav-link" href={localizedPath(locale, item.href)} aria-current={activeNav === item.key ? 'page' : undefined}>
          <LocalizedText value={item.label} />
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  import { lockPageScroll, unlockPageScroll } from '../lib/scroll-lock';
  import '../scripts/glass';
  import '../scripts/selection-slider';
  import '../scripts/site-navigation';

  type PanelName = 'search' | 'navigation';
  const topChrome = document.querySelector<HTMLElement>('[data-top-chrome]');
  const header = topChrome?.querySelector<HTMLElement>('.site-header');
  const triggers = [...(topChrome?.querySelectorAll<HTMLButtonElement>('[data-panel-trigger]') ?? [])];
  const panels = [...(topChrome?.querySelectorAll<HTMLElement>('[data-panel]') ?? [])];
  let openPanelName: PanelName | null = null;
  let closeTimer = 0;
  let panelAnimationTimer = 0;
  let restoringPanelFocus = false;
  const searchBackgroundState = new Map<HTMLElement, boolean>();

  const lockSearchScroll = () => {
    lockPageScroll('search');
    document.querySelector<HTMLElement>('[data-search-backdrop]')?.removeAttribute('hidden');
    document.querySelectorAll<HTMLElement>('main, body > footer').forEach((element) => {
      if (!searchBackgroundState.has(element)) searchBackgroundState.set(element, element.inert);
      element.inert = true;
    });
  };

  const unlockSearchScroll = () => {
    unlockPageScroll('search');
    document.querySelector<HTMLElement>('[data-search-backdrop]')?.setAttribute('hidden', '');
    searchBackgroundState.forEach((inert, element) => { element.inert = inert; });
    searchBackgroundState.clear();
  };

  const closePanel = (restoreFocus = false, immediately = false) => {
    if (!openPanelName) return;
    const previousName = openPanelName;
    const trigger = triggers.find((item) => item.dataset.panelTrigger === previousName);
    const panel = panels.find((item) => item.dataset.panel === previousName);
    panels.forEach((item) => {
      if (item === panel) return;
      item.hidden = true;
      item.classList.remove('is-closing');
    });
    triggers.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    openPanelName = null;
    window.clearTimeout(panelAnimationTimer);
    const collapseSurface = () => {
      topChrome?.removeAttribute('data-panel-open');
    };
    const finishClose = () => {
      collapseSurface();
      if (previousName === 'search') unlockSearchScroll();
      if (!panel) return;
      panel.hidden = true;
      panel.classList.remove('is-closing');
    };
    if (immediately || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      collapseSurface();
      finishClose();
    }
    else {
      panel?.classList.add('is-closing');
      panelAnimationTimer = window.setTimeout(finishClose, 180);
    }
    if (restoreFocus && trigger) {
      if (previousName === 'search') {
        trigger.setAttribute('data-escape-focus', '');
        trigger.addEventListener('blur', () => trigger.removeAttribute('data-escape-focus'), { once: true });
      }
      restoringPanelFocus = true;
      trigger.focus({ preventScroll: true });
      restoringPanelFocus = false;
    }
  };

  const openPanel = (name: PanelName) => {
    window.dispatchEvent(new CustomEvent('site:panel-opening', { detail: { panel: name } }));
    window.clearTimeout(closeTimer);
    window.clearTimeout(panelAnimationTimer);
    panels.forEach((panel) => {
      panel.classList.remove('is-closing');
      panel.hidden = panel.dataset.panel !== name;
    });
    if (name === 'navigation') {
      const panel = panels.find((item) => item.dataset.panel === name);
      if (panel) {
        panel.style.removeProperty('width');
        panel.style.width = `${panel.offsetWidth * 2}px`;
      }
    }
    if (name === 'search') lockSearchScroll();
    else unlockSearchScroll();
    triggers.forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.panelTrigger === name)));
    openPanelName = name;
    header?.classList.remove('is-hidden');
    topChrome?.setAttribute('data-panel-open', name);
    requestAnimationFrame(() => {
      window.dispatchEvent(new CustomEvent('site:panel-opened', { detail: { panel: name } }));
    });
  };

  topChrome?.querySelectorAll('[data-panel-close]').forEach((button) => button.addEventListener('click', () => closePanel(true)));

  triggers.forEach((trigger) => {
    const name = trigger.dataset.panelTrigger as PanelName;
    trigger.addEventListener('click', () => {
      const usesHover = name !== 'search' && hoverQuery.matches;
      if (usesHover) openPanel(name);
      else if (openPanelName === name) closePanel();
      else openPanel(name);
    });
    if (name === 'navigation') {
      trigger.addEventListener('focus', () => {
        if (!restoringPanelFocus && trigger.matches(':focus-visible')) openPanel(name);
      });
    }
  });

  const hoverQuery = matchMedia('(hover: hover) and (pointer: fine)');
  const scheduleClose = () => {
    if (!hoverQuery.matches) return;
    closeTimer = window.setTimeout(() => closePanel(), 150);
  };
  const cancelClose = () => window.clearTimeout(closeTimer);
  triggers.filter((trigger) => trigger.dataset.panelTrigger !== 'search').forEach((trigger) => {
    trigger.addEventListener('pointerenter', () => {
      if (hoverQuery.matches && trigger.offsetParent !== null) openPanel(trigger.dataset.panelTrigger as PanelName);
    });
    trigger.addEventListener('pointerleave', scheduleClose);
  });
  panels.filter((panel) => panel.dataset.panel !== 'search').forEach((panel) => {
    panel.addEventListener('pointerenter', cancelClose);
    panel.addEventListener('pointerleave', scheduleClose);
  });

  panels.forEach((panel) => panel.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closePanel();
  }));
  document.addEventListener('pointerdown', (event) => {
    if (openPanelName && !topChrome?.contains(event.target as Node)) closePanel();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      triggers.forEach((trigger) => trigger.removeAttribute('data-escape-focus'));
      if (openPanelName === 'search') {
        const search = panels.find((panel) => panel.dataset.panel === 'search');
        const controls = [...(search?.querySelectorAll<HTMLElement>('button:not(:disabled), input, a[href]') ?? [])]
          .filter((element) => element.getClientRects().length > 0);
        const first = controls[0];
        const last = controls.at(-1);
        if (first && last && event.shiftKey && (document.activeElement === first || !search?.contains(document.activeElement))) {
          event.preventDefault(); last.focus();
        } else if (first && last && !event.shiftKey && (document.activeElement === last || !search?.contains(document.activeElement))) {
          event.preventDefault(); first.focus();
        }
      }
    }
    if (event.key === 'Escape' && openPanelName) { event.preventDefault(); closePanel(true); }
  });
  window.addEventListener('site:close-panels', (event) => closePanel(false, (event as CustomEvent).detail?.immediately === true));
  document.addEventListener('astro:before-preparation', () => closePanel());
  document.addEventListener('astro:before-swap', () => {
    window.clearTimeout(panelAnimationTimer);
    openPanelName = null;
    topChrome?.removeAttribute('data-panel-open');
    panels.forEach((panel) => { panel.hidden = true; panel.classList.remove('is-closing'); });
    triggers.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    header?.classList.remove('is-hidden');
    unlockSearchScroll();
  });
  addEventListener('resize', () => {
    if (openPanelName === 'navigation' && innerWidth > 760) closePanel();
  }, { passive: true });

</script>
