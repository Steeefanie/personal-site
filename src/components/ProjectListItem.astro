---
import { localeDateFormats, type Locale, type Localized } from '../lib/i18n';
import { localizedPath } from '../lib/routes';

interface LocalizedProject {
  title: string;
  description: string;
  updatedDate?: Date;
  publishDate: Date;
  stack: string[];
  attribution?: string;
}

interface Props {
  slug: string;
  locales: Localized<LocalizedProject>;
  locale: Locale;
}

const { slug, locales: entries, locale } = Astro.props;
const entry = entries[locale];
const formatDate = (locale: keyof typeof entries) => new Intl.DateTimeFormat(
  localeDateFormats[locale],
  { dateStyle: 'long' },
).format(entries[locale].updatedDate ?? entries[locale].publishDate);
---

<li class="content-list-item">
  <a href={localizedPath(locale, `/projects/${slug}/`)}>
    <div>
      <h2 class="item-title">{entry.title}</h2>
      <p class="item-description">{entry.attribution && <span class="content-attribution">{entry.attribution}</span>}{entry.description}</p>
    </div>
    <div class="item-meta">
      <time datetime={(entry.updatedDate ?? entry.publishDate).toISOString()}>{formatDate(locale)}</time>
      <span class="tag-list">{entry.stack.map((item) => <span class="tag">#{item}</span>)}</span>
    </div>
  </a>
</li>
