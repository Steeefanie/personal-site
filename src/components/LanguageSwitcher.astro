---
import { ui } from '../lib/i18n';
import { localeFromPathname } from '../lib/routes';

const locale = localeFromPathname(Astro.url.pathname);
---

<button
  class="utility-button language-switcher"
  type="button"
  data-panel-trigger="language"
  aria-controls="language-panel"
  aria-expanded="false"
  aria-label={ui.common.chooseLanguage[locale]}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.7" />
    <path d="M3.75 12h16.5M12 3.75c2.2 2.25 3.3 5 3.3 8.25S14.2 18 12 20.25C9.8 18 8.7 15.25 8.7 12S9.8 6 12 3.75Z" fill="none" stroke="currentColor" stroke-width="1.45" />
  </svg>
</button>
