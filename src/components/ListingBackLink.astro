---
import LocalizedText from './LocalizedText.astro';
import type { Localized } from '../lib/i18n';

interface Props {
  href: string;
  label: Localized<string>;
}

const { href, label } = Astro.props;
---

<a class="text-link" href={href} data-listing-back><span aria-hidden="true">←</span><LocalizedText value={label} /></a>

<script>
  import { initializeListingBackLinks } from '../scripts/listing-navigation';
  initializeListingBackLinks();
</script>
