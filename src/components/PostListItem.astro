---
import { localeDateFormats, type Locale, type Localized } from '../lib/i18n';
import { localizedPath } from '../lib/routes';

interface Tag { id: string; label: string }
interface LocalizedPost {
  title: string;
  description: string;
  publishDate: Date;
  tags: Tag[];
  readingTime: string;
  attribution?: string;
}

interface Props {
  slug: string;
  locales: Localized<LocalizedPost>;
  locale: Locale;
}

const { slug, locales: entries, locale } = Astro.props;
const entry = entries[locale];
const formatDate = (locale: keyof typeof entries, date: Date) => new Intl.DateTimeFormat(
  localeDateFormats[locale],
  { year: 'numeric', month: locale === 'en' ? 'short' : 'long', day: 'numeric' },
).format(date);
---

<li class="content-list-item">
  <a href={localizedPath(locale, `/blog/${slug}/`)}>
    <div>
      <h2 class="item-title">{entry.title}</h2>
      <p class="item-description">{entry.attribution && <span class="content-attribution">{entry.attribution}</span>}{entry.description}</p>
    </div>
    <div class="item-meta">
      <time datetime={entry.publishDate.toISOString()}>{formatDate(locale, entry.publishDate)}</time>
      <span>{entry.readingTime}</span>
      <span class="tag-list">{entry.tags.map((tag) => <span class="tag">#{tag.label}</span>)}</span>
    </div>
  </a>
</li>
